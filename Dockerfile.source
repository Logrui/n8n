# ==============================================================================
# STAGE 1: Builder
# ==============================================================================
FROM node:22-alpine AS builder

# Support MITM Proxying for Debugging
ARG NODE_TLS_REJECT_UNAUTHORIZED=0
ENV NODE_TLS_REJECT_UNAUTHORIZED=${NODE_TLS_REJECT_UNAUTHORIZED}

# Install build dependencies
RUN apk add --no-cache python3 make g++ git findutils

# Install pnpm specific version
RUN corepack enable && corepack prepare pnpm@10.22.0 --activate

# Set CI to true to skip lefthook install in scripts/prepare.mjs
ENV CI=true

WORKDIR /app

# Copy configuration files first for better caching
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY patches ./patches
COPY .npmrc ./
COPY scripts/block-npm-install.js ./scripts/

# Copy all package.json files from packages
# We use a wildcard copy to get the structure but not all files yet to cache 'pnpm install'
# (This is a simplified approach; true monorepo caching is harder without complex COPYs)
# For simplicity in this "build from source" demo, we'll just copy the whole context
# but properly ignored by .dockerignore if it existed.
# Since we don't have a .dockerignore handy, we copy everything but be mindful.

COPY . .

# Install dependencies (including dev deps for building)
RUN pnpm install --frozen-lockfile

# Build the project
# Use concurrency=1 to force sequential builds and ensure proper dependency ordering
RUN pnpm build --concurrency=1

# Generate licenses (optional but good practice)
RUN node scripts/generate-third-party-licenses.mjs || true

# Deploy the production optimized n8n package to ./compiled
RUN pnpm --filter=n8n --prod --legacy deploy --no-optional ./compiled

# ==============================================================================
# STAGE 2: Runtime
# ==============================================================================
FROM node:22-alpine AS runtime

# Support MITM Proxying for Debugging
ARG NODE_TLS_REJECT_UNAUTHORIZED=0
ENV NODE_TLS_REJECT_UNAUTHORIZED=${NODE_TLS_REJECT_UNAUTHORIZED}

# Install runtime dependencies (matching n8n-base)
RUN apk add --no-cache \
    graphicsmagick \
    tini \
    git \
    openssh \
    openssl \
    ca-certificates \
    tzdata \
    jq

WORKDIR /home/node

# Install npm latest (as done in official Dockerfile)
RUN npm config set strict-ssl false
RUN npm install -g npm@11.6.4

# Copy compiled application from builder
COPY --from=builder /app/compiled /usr/local/lib/node_modules/n8n

# Post-install steps mirroring official Dockerfile
RUN cd /usr/local/lib/node_modules/n8n && \
    npm rebuild sqlite3 && \
    ln -s /usr/local/lib/node_modules/n8n/bin/n8n /usr/local/bin/n8n && \
    mkdir -p /home/node/.n8n && \
    chown -R node:node /home/node

# Copy local entrypoint if exists, or recreate simple one
COPY docker/images/n8n/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

USER node
EXPOSE 5678

ENV NODE_ENV=production
ENV SHELL=/bin/sh

ENTRYPOINT ["tini", "--", "/docker-entrypoint.sh"]
